# Resume Parser & Job Matcher - Environment Configuration

# Claude API Configuration
CLAUDE_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Google Identity Services (OAuth 2.0 Web client ID)
# Create a Web application client in Google Cloud Console and authorize
# http://localhost:8001 as a JavaScript origin (add your deployed origin too).
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Database Configuration
DATABASE_URL=sqlite:///app.db
# For production: postgresql://user:password@localhost/dbname

# Vector Store Configuration
VECTOR_DB_PATH=./chroma_db

# Job API Keys (Optional - for real job searches)
JSEARCH_API_KEY=your_jsearch_key_here
ADZUNA_API_KEY=your_adzuna_key_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Features
ENABLE_API_DOCS=true
ENABLE_CACHING=true
CACHE_TTL=3600
